rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One shared text per team. The long random team code is the only key;
    // listing and deleting are not allowed, so codes cannot be discovered.
    match /rooms/{room} {
      allow get: if room.size() >= 20;
      allow create, update: if room.size() >= 20
        && request.resource.data.keys().hasOnly(['body', 'updatedAt'])
        && request.resource.data.body is string
        && request.resource.data.body.size() < 200000;
    }
  }
}
